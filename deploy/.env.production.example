# ============================================================================
# .env PRODUKSI — Capital Wave
# Salin ke server jadi: /var/www/capitalwave/.env  lalu isi nilai yang CHANGE_ME.
# JANGAN commit file .env asli ke git.
# ============================================================================

APP_NAME="Capital Wave"
APP_ENV=production
APP_KEY=                      # isi dengan: php artisan key:generate
APP_DEBUG=false
APP_URL=https://capitalwavee.com

APP_LOCALE=id
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=id_ID
APP_TIMEZONE=Asia/Jakarta

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_LEVEL=error

# ---- DATABASE (MySQL — import deposit.sql ke DB ini) ----
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=capitalwave
DB_USERNAME=capitalwave
DB_PASSWORD=CHANGE_ME_STRONG_PASSWORD

# ---- SESSION / CACHE / QUEUE (pakai tabel database — sudah ada di dump) ----
SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null
SESSION_SECURE_COOKIE=true

CACHE_STORE=database
QUEUE_CONNECTION=sync          # sync = tanpa worker. Ganti 'database' + jalankan worker kalau perlu antrian.

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local

MAIL_MAILER=log
MAIL_FROM_ADDRESS="no-reply@capitalwavee.com"
MAIL_FROM_NAME="${APP_NAME}"

# ---- Cloudflare Turnstile (anti-bot di link referral /r/{code}) ----
# Ambil dari dash.cloudflare.com > Turnstile > Add Site. Kosongkan = gate dimatikan.
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# ---- Saluran Pembayaran 1: Payment Gateway BankPay (deposit + withdraw) ----
# Notifikasi server dikirim otomatis ke:
#   deposit  https://capitalwavee.com/api/bankpay/deposit-notify
#   withdraw https://capitalwavee.com/api/bankpay/payout-notify
BANKPAY_BASE_URL=https://pay.bankpay.cfd
BANKPAY_MEMBER_ID=CHANGE_ME
BANKPAY_KEY=CHANGE_ME
BANKPAY_CURRENCY=IDR
BANKPAY_BANK_CODE=bank
BANKPAY_EXPIRY_MINUTES=60
# Berapa lama setelah invoice kedaluwarsa statusnya masih ditanyakan ke gateway.
BANKPAY_POLL_GRACE_MINUTES=30

# ---- Pemilihan saluran deposit ----
# Saluran 2 (QRIS statis) butuh QRIS_STATIS + LISTENER_TOKEN terisi.
DEPOSIT_CHANNEL_BANKPAY=true
DEPOSIT_CHANNEL_QRIS_STATIS=true
DEPOSIT_DEFAULT_CHANNEL=bankpay

# Tandai saluran SEDANG BERMASALAH tanpa mematikannya: kartunya diberi label
# GANGGUAN, tidak lagi jadi pilihan default, dan pengumuman muncul otomatis di
# halaman deposit. Nyalakan saat gateway tumbang, matikan lagi setelah pulih.
# Setelah mengubah: php artisan config:cache
DEPOSIT_CHANNEL_BANKPAY_DEGRADED=false
DEPOSIT_CHANNEL_QRIS_STATIS_DEGRADED=false

# Pengumuman bebas di halaman deposit. Kosongkan untuk memakai kalimat
# otomatis dari tanda DEGRADED di atas.
DEPOSIT_NOTICE=

VITE_APP_NAME="${APP_NAME}"
