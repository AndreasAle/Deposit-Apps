# ============================================================================
# .env PRODUKSI — Capital Wave
# Salin ke server jadi: /var/www/capitalwave/.env  lalu isi nilai yang CHANGE_ME.
# JANGAN commit file .env asli ke git.
# ============================================================================

APP_NAME="Capital Wave"
APP_ENV=production
APP_KEY=                      # isi dengan: php artisan key:generate
APP_DEBUG=false
APP_URL=https://capitalwavee.com

APP_LOCALE=id
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=id_ID
APP_TIMEZONE=Asia/Jakarta

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_LEVEL=error

# ---- DATABASE (MySQL — import deposit.sql ke DB ini) ----
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=capitalwave
DB_USERNAME=capitalwave
DB_PASSWORD=CHANGE_ME_STRONG_PASSWORD

# ---- SESSION / CACHE / QUEUE (pakai tabel database — sudah ada di dump) ----
SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null
SESSION_SECURE_COOKIE=true

CACHE_STORE=database
QUEUE_CONNECTION=sync          # sync = tanpa worker. Ganti 'database' + jalankan worker kalau perlu antrian.

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local

MAIL_MAILER=log
MAIL_FROM_ADDRESS="no-reply@capitalwavee.com"
MAIL_FROM_NAME="${APP_NAME}"

# ---- Cloudflare Turnstile (anti-bot di link referral /r/{code}) ----
# Ambil dari dash.cloudflare.com > Turnstile > Add Site. Kosongkan = gate dimatikan.
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# ---- BayarPro Payment Gateway ----
BAYARPRO_BASE_URL=https://bayar-pro.com/api/v1
BAYARPRO_API_KEY=CHANGE_ME
BAYARPRO_SECRET_KEY=CHANGE_ME
BAYARPRO_WEBHOOK_URL=https://capitalwavee.com/api/bayarpro-webhook
BAYARPRO_EXPIRY_PERIOD=1440

VITE_APP_NAME="${APP_NAME}"
